{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.sleekacademia.com"
        }
      ],
      "destination": "https://sleekacademia.com/:path*",
      "statusCode": 301
    },
    {
      "source": "/index.html",
      "destination": "/",
      "statusCode": 301
    },
    {
      "source": "/services.html",
      "destination": "/",
      "statusCode": 301
    },
    {
      "source": "/pricing.html",
      "destination": "/onboard.html",
      "statusCode": 301
    },
    {
      "source": "/blogs.html",
      "destination": "/blog.html",
      "statusCode": 301
    }
  ]
}
