{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "sleek-academia",
      "runtimeExecutable": "node",
      "runtimeArgs": ["dev-server.js"],
      "port": 3000,
      "autoPort": true
    },
    {
      "name": "sleek-academia-full",
      "runtimeExecutable": "node",
      "runtimeArgs": ["server.js"],
      "port": 3200,
      "autoPort": true
    },
    {
      "name": "sleek-academia-chat",
      "runtimeExecutable": "bash",
      "runtimeArgs": [
        "-lc",
        "PORT=3210 ALLOWED_ORIGINS=https://sleekacademia.com,http://localhost:3210,http://127.0.0.1:3210 node server.js"
      ],
      "port": 3210
    }
  ]
}
